										<string name="Name">Cleanup</string>
										<int64 name="SourceAssetId">-1</int64>
										<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
										<UniqueId name="UniqueId">208221cc9007a4bd0a8e571c0000320c</UniqueId>
									</Properties>
