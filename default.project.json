{
  "name": "vise-github",
  "tree": {
    "$ignoreUnknownInstances": true,
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "$path": "src/ReplicatedStorage"
    },

    "StarterGui": {
      "$ignoreUnknownInstances": true,
      "$path": "src/StarterGui",

      "Packages" : {
        "$className":"Folder",
        "$path": "Packages",
        "$ignoreUnknownInstances": true
      }
    },

    "Workspace": {
      "$ignoreUnknownInstances": true
    }
  }
}