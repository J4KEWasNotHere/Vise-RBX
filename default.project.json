{
  "name": "vise-github",
  "tree": {
    "$ignoreUnknownInstances": true,
    "$className": "DataModel",

    "MaterialService": {
      "$ignoreUnknownInstances": true,
      "$path": "src/MaterialService"
    },

    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "$path": "src/ReplicatedStorage"
    },

    "StarterGui": {
      "$ignoreUnknownInstances": true,
      "$path": "src/StarterGui"
    },

    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "FilteringEnabled": true
      }
    },

    "Lighting": {
      "$ignoreUnknownInstances": true
    }
  }
}